# Docker image tag used by docker-compose.yml.
INTERNET_MONITOR_IMAGE=internet-monitor:latest

# Host port published by Docker. The Flask process inside the container uses
# INTERNET_MONITOR_WEB_PORT.
INTERNET_MONITOR_WEB_HOST_PORT=5005

# Monitor behavior.
INTERNET_MONITOR_DEBUG=false
INTERNET_MONITOR_PING_HOST=1.1.1.1
INTERNET_MONITOR_BACKUP_PING_HOST=8.8.8.8
INTERNET_MONITOR_DNS_HOST=www.google.com
INTERNET_MONITOR_PINGS=5
INTERNET_MONITOR_PING_PERIOD_MS=1000
INTERNET_MONITOR_PING_TIMEOUT_MS=1000
INTERNET_MONITOR_INTERVAL=10
INTERNET_MONITOR_TRIGGER=3
INTERNET_MONITOR_HIGH_LATENCY_MS=1000
INTERNET_MONITOR_DNS_FAILURE_TRIGGER=3
INTERNET_MONITOR_MAX_ALERTS_PER_HOUR=5
INTERNET_MONITOR_LOSS_ALERT_DELAY_SECONDS=300
INTERNET_MONITOR_LATENCY_ALERT_DELAY_SECONDS=300
INTERNET_MONITOR_OUTAGE_ALERT_DELAY_SECONDS=300
INTERNET_MONITOR_LOG_PATH=/data/connection.log
INTERNET_MONITOR_STATUS_PATH=/data/connection_status.json
INTERNET_MONITOR_TIMEZONE=America/Detroit

# Web UI behavior.
INTERNET_MONITOR_WEB_TITLE=Internet Connection Log
INTERNET_MONITOR_WEB_PORT=5005
INTERNET_MONITOR_WEB_WORKERS=1
INTERNET_MONITOR_WEB_THREADS=2
INTERNET_MONITOR_WEB_LOG_PATH=/data/connection.log
INTERNET_MONITOR_WEB_LOG_LINES=200
INTERNET_MONITOR_WEB_ALLOWED_HOSTS=
INTERNET_MONITOR_WEB_STATUS_PATH=/data/connection_status.json
INTERNET_MONITOR_WEB_STATUS_MAX_AGE=300

# Optional Pushover notifications. Leave blank to disable.
INTERNET_MONITOR_PUSHOVER_TOKEN=
INTERNET_MONITOR_PUSHOVER_USER=
INTERNET_MONITOR_PUSHOVER_DEVICE=
INTERNET_MONITOR_PUSHOVER_PRIORITY=0
