# Image and ingress settings.
IMAGE=internet-monitor:0.2.0
# Published Docker host or Swarm ingress port. The container always uses 5005.
WEB_PORT=5005

# Human-readable Docker console logging.
LOG_LEVEL=INFO

# Internet and ICMP monitoring.
PING_HOST=1.1.1.1
BACKUP_PING_HOST=8.8.8.8
# Optional pingable hops in order from the monitoring server toward the Internet.
GATEWAY_1_IP=
GATEWAY_2_IP=
# Optional DNS-gated hostnames to ping. Configure two or three as needed.
IMPORTANT_HOST_1=
IMPORTANT_HOST_2=
IMPORTANT_HOST_3=
PINGS=5
PING_PERIOD_MS=1000
PING_TIMEOUT_MS=1000
INTERVAL=10
TRIGGER=3
HIGH_LATENCY_MS=1000
LOSS_ALERT_DELAY_SECONDS=300
LATENCY_ALERT_DELAY_SECONDS=300
OUTAGE_ALERT_DELAY_SECONDS=300

# System-resolver and per-server dig checks.
DNS_HOST=www.google.com
DNS_SERVERS=1.1.1.1,8.8.8.8
DNS_RECORD_TYPE=A
DNS_TIMEOUT_SECONDS=5
DNS_SLOW_THRESHOLD_MS=500
DNS_FAILURE_TRIGGER=3

# Process-local alert behavior. Counters and queued messages reset on restart.
MAX_ALERTS_PER_HOUR=5
TIMEZONE=America/Detroit

# Ephemeral 30-day dashboard state. Do not use persistent storage.
STATUS_PATH=/tmp/internet-monitor/status.json
HISTORY_PATH=/tmp/internet-monitor/history.json
HISTORY_MAX_POINTS=720

# Web dashboard and Gunicorn.
WEB_TITLE=Internet Monitor
WEB_WORKERS=1
WEB_THREADS=2
WEB_ALLOWED_HOSTS=
WEB_STATUS_MAX_AGE=300

# Optional Pushover notifications. Direct values are convenient for Compose.
# For Swarm, prefer the Docker secret overlay documented in INSTALL.md. When a
# *_FILE value is set, its file content takes precedence over the direct value.
PUSHOVER_TOKEN=
PUSHOVER_TOKEN_FILE=
PUSHOVER_USER=
PUSHOVER_USER_FILE=
PUSHOVER_DEVICE=
PUSHOVER_PRIORITY=0
PUSHOVER_TIMEOUT_SECONDS=10
PUSHOVER_RETRY_INITIAL_SECONDS=30
PUSHOVER_RETRY_MAX_SECONDS=900

# Docker health check timing.
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_START_PERIOD=20s
HEALTHCHECK_RETRIES=3
