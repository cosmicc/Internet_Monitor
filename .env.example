# Image and ingress settings.
INTERNET_MONITOR_IMAGE=internet-monitor:0.1.1
INTERNET_MONITOR_WEB_HOST_PORT=5005

# Human-readable Docker console logging.
INTERNET_MONITOR_LOG_LEVEL=INFO

# Internet and ICMP monitoring.
INTERNET_MONITOR_PING_HOST=1.1.1.1
INTERNET_MONITOR_BACKUP_PING_HOST=8.8.8.8
# Optional pingable hops in order from the monitoring server toward the Internet.
INTERNET_MONITOR_GATEWAY_1_IP=
INTERNET_MONITOR_GATEWAY_2_IP=
INTERNET_MONITOR_PINGS=5
INTERNET_MONITOR_PING_PERIOD_MS=1000
INTERNET_MONITOR_PING_TIMEOUT_MS=1000
INTERNET_MONITOR_INTERVAL=10
INTERNET_MONITOR_TRIGGER=3
INTERNET_MONITOR_HIGH_LATENCY_MS=1000
INTERNET_MONITOR_LOSS_ALERT_DELAY_SECONDS=300
INTERNET_MONITOR_LATENCY_ALERT_DELAY_SECONDS=300
INTERNET_MONITOR_OUTAGE_ALERT_DELAY_SECONDS=300

# System-resolver and per-server dig checks.
INTERNET_MONITOR_DNS_HOST=www.google.com
INTERNET_MONITOR_DNS_SERVERS=1.1.1.1,8.8.8.8
INTERNET_MONITOR_DNS_RECORD_TYPE=A
INTERNET_MONITOR_DNS_TIMEOUT_SECONDS=5
INTERNET_MONITOR_DNS_SLOW_THRESHOLD_MS=500
INTERNET_MONITOR_DNS_FAILURE_TRIGGER=3

# Process-local alert behavior. Counters and queued messages reset on restart.
INTERNET_MONITOR_MAX_ALERTS_PER_HOUR=5
INTERNET_MONITOR_TIMEZONE=America/Detroit

# Ephemeral dashboard snapshot. Do not point this at persistent storage.
INTERNET_MONITOR_STATUS_PATH=/tmp/internet-monitor/status.json

# Web dashboard and Gunicorn.
INTERNET_MONITOR_WEB_TITLE=Internet Monitor
INTERNET_MONITOR_WEB_PORT=5005
INTERNET_MONITOR_WEB_WORKERS=1
INTERNET_MONITOR_WEB_THREADS=2
INTERNET_MONITOR_WEB_ALLOWED_HOSTS=
INTERNET_MONITOR_WEB_STATUS_MAX_AGE=300

# Optional Pushover notifications. Direct values are convenient for Compose.
# For Swarm, prefer the Docker secret overlay documented in INSTALL.md. When a
# *_FILE value is set, its file content takes precedence over the direct value.
INTERNET_MONITOR_PUSHOVER_TOKEN=
INTERNET_MONITOR_PUSHOVER_TOKEN_FILE=
INTERNET_MONITOR_PUSHOVER_USER=
INTERNET_MONITOR_PUSHOVER_USER_FILE=
INTERNET_MONITOR_PUSHOVER_DEVICE=
INTERNET_MONITOR_PUSHOVER_PRIORITY=0
INTERNET_MONITOR_PUSHOVER_TIMEOUT_SECONDS=10
INTERNET_MONITOR_PUSHOVER_RETRY_INITIAL_SECONDS=30
INTERNET_MONITOR_PUSHOVER_RETRY_MAX_SECONDS=900

# Docker health check timing.
INTERNET_MONITOR_HEALTHCHECK_INTERVAL=30s
INTERNET_MONITOR_HEALTHCHECK_TIMEOUT=5s
INTERNET_MONITOR_HEALTHCHECK_START_PERIOD=20s
INTERNET_MONITOR_HEALTHCHECK_RETRIES=3
